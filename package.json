{
  "name": "itr-engineering",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/serve.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test --workers=2",
    "format": "prettier --write src tests scripts *.js package.json README.md",
    "format:check": "prettier --check src tests scripts *.js package.json README.md"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9"
  }
}
